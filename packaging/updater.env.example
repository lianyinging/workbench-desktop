# Copy to a local (gitignored) updater.env, or set the same names as GitHub Actions secrets.
#
# Required for auto-update artifacts (.sig) and latest.json:
#   GitHub → Settings → Secrets → Actions
#   TAURI_SIGNING_PRIVATE_KEY = contents of ~/.opc-workbench/tauri-updater.key
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD = (leave empty if key has no password)
#
# Optional — Aliyun OSS / CDN public base (no trailing slash). When set in CI,
# packaging/make_update_manifest.py writes asset urls under this base.
# Also change tauri.conf.json plugins.updater.endpoints to:
#   ["https://YOUR_BUCKET.../opc-workbench/latest.json"]
#
# Example:
#   OPC_UPDATE_PUBLIC_BASE=https://my-bucket.oss-cn-hangzhou.aliyuncs.com/opc-workbench
OPC_UPDATE_PUBLIC_BASE=
